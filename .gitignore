# ── Editor / OS / tooling ───────────────────────────────────────────────
/.claude
.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store
Thumbs.db

# ── Quarto / knitr render products (regenerated from the .qmd sources) ────
*.html
*_files/
/_freeze/
/.quarto/
*.rmarkdown
*.knit.md
reports/

# ── Derived analysis artifacts (all regenerated by the pipeline) ─────────
# The whole artifacts/ tree is derived from the .qmd + R/ sources. Nothing
# in it is a primary input, so none of it is tracked.
artifacts/

# ── Fetched metadata cache: re-downloaded by 00-onboarding.qmd + R/metadata.R
#    from pinned sources; regenerated, never committed. (The two hand-authored
#    curation CSVs live in curation/, which IS tracked.)
dataset_metadata/

# ── Heavy per-tool working directories ──────────────────────────────────
sirius_projects/
*.sirius
figures/
peaks/
peaks_review/
peaks_review_v2/
peaks_focused/
rt_snap/

# Superseded StructureMASST web exports (kept locally, replaced by FASSTrecords)
StructureMASST_output/_archive_webexport/

# ── Backups, snapshots, one-off exports ─────────────────────────────────
*.bak
*.bak-*
*.bak[0-9]
*.orig
*.zip
*.prev

# ── Presentations + deck build scripts (not part of the analysis) ────────
*.pptx
*.potx
deck/

# ── Logs and scratch output ─────────────────────────────────────────────
*.log
yield_out.txt
diag_*/
_*_tmp.R
*_tmp.R

# ── BiocFileCache / large raw MS data (never committed) ──────────────────
*.mzML
*.mzXML
*.raw
docs/TODO.md
/docs

# ── LaTeX build products (thesis/preview.pdf is the only kept output) ────
thesis/*.aux
thesis/*.bbl
thesis/*.bcf
thesis/*.blg
thesis/*.fdb_latexmk
thesis/*.fls
thesis/*.log
thesis/*.run.xml
thesis/*-SAVE-ERROR
# page previews rendered for visual checks; the PDF is the kept output
thesis/*.jpg
thesis/*.png
/thesis
/results
